# LiveKit credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Rime TTS
RIME_API_KEY=your_rime_api_key

# Deepgram STT
DEEPGRAM_API_KEY=your_deepgram_api_key

# GPT-OSS Orchestration (OpenAI-compatible / Groq / LiveKit Inference / Ollama)
GPT_OSS_BASE_URL=https://api.livekit.io/v1
GPT_OSS_API_KEY=your_gpt_oss_api_key
GPT_OSS_MODEL=gpt-oss-120b

# Pronunciation Diagnosis Tuning
CONFIDENCE_THRESHOLD=0.70

# Barge-In Test Hook
INJECT_TTS_DELAY_MS=0
